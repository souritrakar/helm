#!/usr/bin/env bash
# State and logs belong to this user's XDG state directory, never FM_HOME.
set -euo pipefail
readonly HELM_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
readonly HELM_STATE_DIR="${HELM_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/helm}"
readonly PID_FILE="$HELM_STATE_DIR/helm.pid"
readonly LOG_FILE="$HELM_STATE_DIR/helm.log"
usage() { echo "usage: bin/helm {doctor|build|start|stop|status|logs|install-service}" >&2; }
ensure_state_dir() { mkdir -p "$HELM_STATE_DIR"; }
pid_is_live() { [[ -s "$PID_FILE" ]] && kill -0 "$(<"$PID_FILE")" 2>/dev/null; }
remove_stale_pid() { [[ -e "$PID_FILE" ]] && ! pid_is_live && rm -f "$PID_FILE" || true; }
rotate_logs() {
  ensure_state_dir
  local max_bytes=$((10 * 1024 * 1024)) index
  [[ -f "$LOG_FILE" && $(wc -c < "$LOG_FILE") -ge $max_bytes ]] || return 0
  for ((index=4; index>=1; index--)); do [[ -f "$LOG_FILE.$index" ]] && mv -f "$LOG_FILE.$index" "$LOG_FILE.$((index + 1))"; done
  mv -f "$LOG_FILE" "$LOG_FILE.1"
}
doctor() { pnpm --dir "$HELM_ROOT" exec tsx "$HELM_ROOT/bin/helm-doctor.ts"; }
start() {
  ensure_state_dir; remove_stale_pid
  if pid_is_live; then echo "helm: already running (pid $(<"$PID_FILE")); refusing to double-bind" >&2; return 1; fi
  doctor; rotate_logs
  if [[ "${HELM_FOREGROUND:-0}" == "1" ]]; then
    echo "$$" > "$PID_FILE"; trap 'rm -f "$PID_FILE"' EXIT
    exec >> "$LOG_FILE" 2>&1; exec pnpm --dir "$HELM_ROOT" start
  fi
  (cd "$HELM_ROOT" && pnpm start >> "$LOG_FILE" 2>&1 & echo $! > "$PID_FILE")
  sleep 1
  pid_is_live && { echo "helm: started (pid $(<"$PID_FILE"))"; return 0; }
  echo "helm: failed to start; see $LOG_FILE" >&2; return 1
}
stop() {
  if systemctl --user is-active --quiet helm.service 2>/dev/null; then systemctl --user stop helm.service; echo "helm: systemd service stopped"; return 0; fi
  remove_stale_pid
  if ! pid_is_live; then echo "helm: not running"; return 0; fi
  kill -TERM "$(<"$PID_FILE")"
  for _ in {1..30}; do pid_is_live || { rm -f "$PID_FILE"; echo "helm: stopped"; return 0; }; sleep 0.1; done
  echo "helm: process did not stop cleanly" >&2; return 1
}
status() {
  remove_stale_pid
  local unit="inactive" process="stopped"
  systemctl --user is-active --quiet helm.service 2>/dev/null && unit="active"
  pid_is_live && process="running (pid $(<"$PID_FILE"))"
  echo "helm: service=$unit process=$process bind=${HELM_BIND:-127.0.0.1}:${HELM_PORT:-7333}"
  [[ "$unit" == "active" || "$process" == running* ]]
}
logs() { ensure_state_dir; [[ -f "$LOG_FILE" ]] && tail -n 200 "$LOG_FILE" || echo "helm: no service log at $LOG_FILE"; }
install_service() {
  local unit_dir="$HOME/.config/systemd/user" template temp
  mkdir -p "$unit_dir"
  for template in "$HELM_ROOT/systemd/helm.service" "$HELM_ROOT/systemd/helm-logrotate.service" "$HELM_ROOT/systemd/helm-logrotate.timer"; do
    temp="$(mktemp)"
    sed -e "s|@HELM_ROOT@|$HELM_ROOT|g" -e "s|@HELM_STATE_DIR@|$HELM_STATE_DIR|g" -e "s|@FM_HOME@|${FM_HOME:-$HOME/firstmate}|g" "$template" > "$temp"
    install -m 0644 "$temp" "$unit_dir/$(basename "$template")"; rm -f "$temp"
  done
  systemctl --user daemon-reload; loginctl enable-linger "$(id -un)"; systemctl --user enable helm.service helm-logrotate.timer
  echo "helm: installed user service; linger enabled; fallback if policy blocks linger: crontab -e then add '@reboot $HELM_ROOT/bin/helm start'"
}
case "${1:-}" in
  doctor) doctor ;; build) pnpm --dir "$HELM_ROOT" build ;; start) start ;; stop) stop ;; status) status ;;
  logs) logs ;; rotate-logs) rotate_logs ;; install-service) install_service ;; *) usage; exit 2 ;;
esac
